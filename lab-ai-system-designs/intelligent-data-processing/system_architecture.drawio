M test vs B0&#xa;p &lt; 0.05 (FDR)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="270" y="125" width="170" height="90" as="geometry"/></mxCell><mxCell id="g2" value="80% coverage&#xa;in 75–85%?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="480" y="125" width="170" height="90" as="geometry"/></mxCell><mxCell id="rev" value="✍️ Quant lead + compliance&#xa;PR review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="690" y="140" width="210" height="60" as="geometry"/></mxCell><mxCell id="shadow" value="👥 Shadow in ledger&#xa;(≥ 1 cycle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="940" y="140" width="180" height="60" as="geometry"/></mxCell><mxCell id="champ" value="🏆 Champion&#xa;(sponsor-only until OD-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1160" y="140" width="210" height="60" as="geometry"/></mxCell><mxCell id="naive" value="📉 Publish labelled naive range&#xa;model_not_validated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="240" height="60" as="geometry"/></mxCell><mxCell id="cand_g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#00695c;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="cand" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g1_g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;or