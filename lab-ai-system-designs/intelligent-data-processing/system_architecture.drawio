" parent="1"><mxGeometry x="40" y="420" width="800" height="520" as="geometry"/></mxCell><mxCell id="lev_hdr" value="💡 Cost levers" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=#00695c;strokeColor=none;fontColor=#ffffff;rounded=1;arcSize=20;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="780" height="30" as="geometry"/></mxCell><mxCell id="lv0" value="⏱️ p95 run &lt; 20 min → 66 runs ≈ 1,320 min (fits 2,000 Free)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="760" height="52" as="geometry"/></mxCell><mxCell id="lv1" value="🧮 Training in separate monthly job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="544" width="760" height="52" as="geometry"/></mxCell><mxCell id="lv2" value="🌲 CPU-only models (LightGBM, linear, GARCH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="608" width="760" height="52" as="geometry"/></mxCell><mxCell id="lv3" value="📅 Year-partitioned CSVs → small commits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="672" width="760" height="52" as="geometry"/></mxCell><mxCell id="lv4" value="🚫 No intraday history in Git (OD-25)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="736" width="760" height="52" as="geometry"/></mxCell><mxCell id="lv5" value="🔢 Per-run and daily LLM token caps (NFR-061)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00