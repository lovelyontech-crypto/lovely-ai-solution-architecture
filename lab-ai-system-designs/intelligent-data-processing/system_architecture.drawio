dgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="🧠 8 Recompute features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="220" height="70" as="geometry"/></mxCell><mxCell id="se7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s8" value="🧠 9 Load approved models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="290" y="360" width="220" height="70" as="geometry"/></mxCell><mxCell id="se8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s9" value="🧠 10 Analytics, forecasts, risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="540" y="360" width="220" height="70" as="geometry"/></mxCell><mxCell id="se9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s10" value="🧠 11 Save predictions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="360" width="220" height="70" as="geometry"/></mxCell><mxCell id="se10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s11" value="🧠 12 HTML report + CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="220" height="70" as="geometry"/></mxCell><mxCell id="se11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s12" value="🧠 13 Email / failure notice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1290" y="360" width="220" height="70" as="geometry"/></mxCell><mxCell id="se12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s13" value="🧠 14 Commit + job summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1540" y="360" width="220" height="70" as="geometry"/></mxCell><mxCell id="se13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s12" target="s13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tools" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#81d4fa;strokeWidth=2;arcSize=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1100" height="170" as="geometry"/></mxCell><mxCell id="tools_hdr" value="Tools called as Python modules (no LLM tool-calling)" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=#0277bd;strokeColor=none;fontColor=#ffffff;rounded=1;arcSize=20;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="1080" height="30" as="geometry"/></mxCell><mxCell id="t0" value="📊 fundamentals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="165" height="60" as="geometry"/></mxCell><mxCell id="t1" value="📈 technicals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="240" y="580" width="165" height="60" as="geometry"/></mxCell><mxCell id="t2" value="💰 valuation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="420" y="580" width="165" height="60" as="geometry"/></mxCell><mxCell id="t3" value="🛑 risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="600" y="580" width="165" height="60" as="geometry"/></mxCell><mxCell id="t4" value="🧾 derivatives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="780" y="580" width="165" height="60" as="geometry"/></mxCell><mxCell id="t5" value="🌲 forecasting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="960" y="580" width="165" height="60" as="geometry"/></mxCell><mxCell id="mem" value="🗄️ State = data branch&#xa;(no conversation memory)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="1200" y="540" width="220" height="110" as="geometry"/></mxCell><mxCell id="why" value="Why no agents: the BRD requires one deterministic&#xa;implementation of every step and forbids the LLM&#xa;from producing numbers (G-3, FR-152). The LLM is a&#xa;single bounded call in step 12." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1460" y="520" width="300" height="140" as="geometry"/></mxCell><mxCell id="te" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#0277bd;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s9" target="t0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te_lbl" value="invoke" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="te"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="tm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#7b1fa2;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="s6" target="mem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tm_lbl" value="write" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="tm"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page9" name="9 FinOps &amp; Cost Optimisation"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FinOps &amp; Cost Optimisation" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1a237e;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1600" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Costs: Actions minutes · data licence (OD-02) · LLM tokens. Tracked per run (KPI-23)" style="text;html=1;fontSize=13;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#455a64;" vertex="1" parent="1"><mxGeometry x="50" y="55" width="1600" height="25" as="geometry"/></mxCell><mxCell id="start" value="▶️ Run starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="170" height="50" as="geometry"/></mxCell><mxCell id="dnew" value="New data since&#xa;last confirmed date?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="reuse" value="♻️ No historical requests&#xa;(NFR-091, TST-HIST-B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="260" y="260" width="200" height="60" as="geometry"/></mxCell><mxCell id="fetch" value="⬇️ Fetch missing ranges only&#xa;+ 5-day look-back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="220" height="60" as="geometry"/></mxCell><mxCell id="dcache" value="Narrative cached&#xa;for this snapshot?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="cached" value="♻️ Reuse cached narrative&#xa;($0 LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="770" y="260" width="200" height="60" as="geometry"/></mxCell><mxCell id="dtask" value="Task type?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="1020" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="rules" value="📏 Rules / TF-IDF&#xa;(filing class, linking) $0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1020" y="260" width="200" height="60" as="geometry"/></mxCell><mxCell id="small" value="🤖 Mid-tier LLM, temp 0&#xa;(narrative) $$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0277bd;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1270" y="130" width="200" height="60" as="geometry"/></mxCell><mxCell id="tmpl" value="📄 Template report&#xa;when budget cap hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1;fontSize=11;arcSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1270" y="260" width="200" height="60" as="geometry"/></mxCell><mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="dnew"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#43a047;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="dnew" target="reuse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2_lbl" value="no" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#ef6c00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="dnew" target="fetch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3_lbl" value="yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="fetch" target="dcache"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#43a047;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="dcache" target="cached"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5_lbl" value="yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#ef6c00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="dcache" target="dtask"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6_lbl" value="no" style="edgeLabel;html=1;alig